# Hinweis: Der Sync funktioniert aktuell nur mit Strava-Premium-Accounts.
#
# Jeder Athlet erstellt seine eigene kostenlose Strava App:
# https://www.strava.com/settings/api
# → Authorization Callback Domain: localhost
#
# Pro Athlet ein Block. Präfix = Profilname in Großbuchstaben
# (athletes/alex.md → ALEX_). Setup: .venv/bin/python strava/sync.py --setup-alex

ALEX_CLIENT_ID=
ALEX_CLIENT_SECRET=
ALEX_REFRESH_TOKEN=
ALEX_ATHLETE_ID=
